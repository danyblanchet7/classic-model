		cfluxcg:_FillValue = -999. ;
		cfluxcg:long_name = "Aerodynamic conductance, canopy over ground" ;
		cfluxcg:units = "m/s" ;
	double cfluxcs(tile, lat, lon) ;
		cfluxcs:_FillValue = -999. ;
		cfluxcs:long_name = "Aerodynamic conductance, canopy over snow" ;
		cfluxcs:units = "m/s" ;
	double co2i1cg(tile, icc, lat, lon) ;
		co2i1cg:_FillValue = -999. ;
		co2i1cg:long_name = "Intercellular CO2, single/sunlit leaf, canopy over ground" ;
		co2i1cg:units = "Pascals" ;
	double co2i1cs(tile, icc, lat, lon) ;
		co2i1cs:_FillValue = -999. ;
		co2i1cs:long_name = "Intercellular CO2, single/sunlit leaf, canopy over snow" ;
		co2i1cs:units = "Pascals" ;
	double co2i2cg(tile, icc, lat, lon) ;
		co2i2cg:_FillValue = -999. ;
		co2i2cg:long_name = "Intercellular CO2, shaded leaf, canopy over ground" ;
		co2i2cg:units = "Pascals" ;
	double co2i2cs(tile, icc, lat, lon) ;
		co2i2cs:_FillValue = -999. ;
		co2i2cs:long_name = "Intercellular CO2, shaded leaf, canopy over snow" ;
		co2i2cs:units = "Pascals" ;
