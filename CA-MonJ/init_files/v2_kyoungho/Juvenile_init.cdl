		colddays_harvest:_FillValue = -999. ;
		colddays_harvest:long_name = "Cold days counters for CROPS (days below temperature threshold for harvest)" ;
		colddays_harvest:units = "-" ;
	double colddays_leaffall(tile, lat, lon) ;
		colddays_leaffall:_FillValue = -999. ;
		colddays_leaffall:long_name = "Cold days counters for NDL DCD TREES (days below temperature threshold for leaf fall)" ;
		colddays_leaffall:units = "-" ;
