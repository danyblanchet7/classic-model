netcdf treeheights_init {
dimensions:
	tile = 1 ;
	lat = 1 ;
	lon = 1 ;
	icp1 = 6 ;
	layer = 20 ;
	ic = 5 ;
	icc = 12 ;
	iccp1 = 13 ;
	iccp2 = 14 ;
	slope = 8 ;
variables:
	double ALBS(tile, lat, lon) ;
		ALBS:_FillValue = -999. ;
		ALBS:units = "-" ;
		ALBS:long_name = "Snow albedo" ;
	double ALIC(tile, icp1, lat, lon) ;
		ALIC:_FillValue = -999. ;
		ALIC:units = "-" ;
		ALIC:long_name = "Average near-IR albedo of vegetation category when fully-leafed" ;
	double ALVC(tile, icp1, lat, lon) ;
		ALVC:_FillValue = -999. ;
		ALVC:units = "-" ;
		ALVC:long_name = "Average visible albedo of vegetation category when fully-leafed" ;
	double CLAY(tile, layer, lat, lon) ;
		CLAY:_FillValue = NaN ;
		CLAY:units = "%" ;
		CLAY:long_name = "Percentage clay content" ;
	double CMAS(tile, ic, lat, lon) ;
		CMAS:_FillValue = -999. ;
		CMAS:units = "$[kg m^{-2} ]$" ;
		CMAS:long_name = "Annual maximum canopy mass for vegetation category" ;
	double Cmossmas(tile, lat, lon) ;
		Cmossmas:_FillValue = -999. ;
		Cmossmas:units = "kgC/m2" ;
		Cmossmas:long_name = "C in moss biomass" ;
	double DELZ(layer) ;
		DELZ:_FillValue = NaN ;
		DELZ:units = "m" ;
		DELZ:long_name = "Ground layer thickness" ;
	double DRN(tile, lat, lon) ;
		DRN:_FillValue = -999. ;
		DRN:units = "-" ;
		DRN:long_name = "Soil drainage index" ;
	double FARE(tile, lat, lon) ;
		FARE:_FillValue = -999. ;
		FARE:units = "fraction" ;
		FARE:long_name = "Tile fractional area of gridcell" ;
	double FCAN(tile, icp1, lat, lon) ;
		FCAN:_FillValue = -999. ;
		FCAN:units = "-" ;
		FCAN:long_name = "Annual maximum fractional coverage of modelled area (read in for CLASS only runs)" ;
	double FLND(lat, lon) ;
		FLND:_FillValue = -999. ;
		FLND:long_name = "Fractional land cover. Excludes lakes, glaciers, and icesheets" ;
		FLND:units = "-" ;
	double GRO(tile, lat, lon) ;
		GRO:_FillValue = -999. ;
		GRO:units = "-" ;
		GRO:long_name = "Vegetation growth index" ;
	double LNZ0(tile, icp1, lat, lon) ;
		LNZ0:_FillValue = -999. ;
		LNZ0:units = "-" ;
		LNZ0:long_name = "Natural logarithm of maximum vegetation roughness length" ;
