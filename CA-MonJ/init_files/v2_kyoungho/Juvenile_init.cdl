		ORGM:_FillValue = NaN ;
		ORGM:units = "%" ;
		ORGM:long_name = "Percentage organic matter content" ;
	double PAMN(tile, ic, lat, lon) ;
		PAMN:_FillValue = -999. ;
		PAMN:units = "m2/m2" ;
		PAMN:long_name = "Annual minimum plant area index of vegetation category" ;
	double PAMX(tile, ic, lat, lon) ;
		PAMX:_FillValue = -999. ;
		PAMX:units = "m2/m2" ;
		PAMX:long_name = "Annual maximum plant area index of vegetation category" ;
	double RCAN(tile, lat, lon) ;
		RCAN:_FillValue = -999. ;
		RCAN:units = "-" ;
		RCAN:long_name = "Intercepted liquid water stored on canopy" ;
	double RHOS(tile, lat, lon) ;
		RHOS:_FillValue = -999. ;
		RHOS:units = "kg/m3" ;
		RHOS:long_name = "Density of snow" ;
	double ROOT(tile, ic, lat, lon) ;
		ROOT:_FillValue = -999. ;
		ROOT:units = "m" ;
		ROOT:long_name = "Annual maximum rooting depth of vegetation category" ;
	double SAND(tile, layer, lat, lon) ;
		SAND:_FillValue = NaN ;
		SAND:units = "%" ;
		SAND:long_name = "Percentage sand content" ;
	double SCAN(tile, lat, lon) ;
		SCAN:_FillValue = -999. ;
		SCAN:units = "kg/m2" ;
		SCAN:long_name = "Intercepted frozen water stored on canopy" ;
	double SDEP(tile, lat, lon) ;
		SDEP:_FillValue = -999. ;
		SDEP:units = "m" ;
		SDEP:long_name = "Soil permeable depth" ;
	double SNO(tile, lat, lon) ;
		SNO:_FillValue = -999. ;
		SNO:units = "kg/m2" ;
		SNO:long_name = "Mass of snow pack" ;
	double SOCI(tile, lat, lon) ;
		SOCI:_FillValue = -999. ;
		SOCI:units = "index" ;
		SOCI:long_name = "Soil colour index" ;
	double TBAR(tile, layer, lat, lon) ;
		TBAR:_FillValue = NaN ;
		TBAR:units = "C" ;
		TBAR:long_name = "Temperature of soil layers" ;
	double TCAN(tile, lat, lon) ;
		TCAN:_FillValue = -999. ;
		TCAN:units = "C" ;
		TCAN:long_name = "Vegetation canopy temperature" ;
	double THIC(tile, layer, lat, lon) ;
		THIC:_FillValue = NaN ;
		THIC:units = "m3/m3" ;
		THIC:long_name = "Volumetric frozen water content of soil layers" ;
	double THLQ(tile, layer, lat, lon) ;
		THLQ:_FillValue = NaN ;
		THLQ:units = "m3/m3" ;
		THLQ:long_name = "Volumetric liquid water content of soil layers" ;
	double TPND(tile, lat, lon) ;
		TPND:_FillValue = -999. ;
		TPND:units = "C" ;
		TPND:long_name = "Temperature of ponded water" ;
	double TSNO(tile, lat, lon) ;
		TSNO:_FillValue = -999. ;
		TSNO:units = "C" ;
		TSNO:long_name = "Snowpack temperature" ;
	double ZPND(tile, lat, lon) ;
		ZPND:_FillValue = -999. ;
		ZPND:units = "m" ;
		ZPND:long_name = "Depth of ponded water on surface" ;
	double anndefct(lat, lon) ;
		anndefct:_FillValue = -999. ;
		anndefct:units = "mm" ;
		anndefct:long_name = "Annual water deficit (PFTCompetition variable)" ;
	double annpcp(lat, lon) ;
		annpcp:_FillValue = -999. ;
		annpcp:units = "mm" ;
		annpcp:long_name = "Annual precipitation (PFTCompetition variable)" ;
	double annsrpls(lat, lon) ;
		annsrpls:_FillValue = -999. ;
		annsrpls:units = "mm" ;
		annsrpls:long_name = "Annual water surplus (PFTCompetition variable)" ;
	double aridity(lat, lon) ;
		aridity:_FillValue = -999. ;
		aridity:units = "-" ;
		aridity:long_name = "Aridity index, ratio of potential evaporation to precipitation (PFTCompetition variable)" ;
